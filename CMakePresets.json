{
    "version": 8,
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "configurePresets": [
        {
            "name": "linux-base",
            "displayName": "linux-base",
            "description": "Base configuration for linux builds",
            "generator": "Ninja Multi-Config",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Asan;Msan",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/bin",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -Wall -Werror -pedantic",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -ggdb -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_DEBUG": "-Og -ggdb -Wall -Werror -pedantic",
                "CMAKE_CXX_FLAGS_ASAN": "-O0 -ggdb -fsanitize=address,undefined -Wall -Werror -pedantic",
                "CMAKE_CXX_FLAGS_MSAN": "-O0 -ggdb -fsanitize=memory -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_ASAN": "-O0 -ggdb -fsanitize=address,undefined -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_MSAN": "-O0 -ggdb -fsanitize=memory,undefined -Wall -Werror -pedantic",
                "CMAKE_EXE_LINKER_FLAGS_ASAN": "-fsanitize=address,undefined",
                "CMAKE_EXE_LINKER_FLAGS_MSAN": "-fsanitize=memory,undefined"
            }
        },
        {
            "name": "linux-gcc",
            "description": "Build for linux with gcc",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "description": "Build for linux with clang",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "windows-msvc",
            "description": "Base configuration for windows builds",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x86",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Asan",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/bin",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG /Wall /EHsc",
                "CMAKE_C_FLAGS_RELEASE": "/O2 /DNDEBUG /Wall /EHsc",
                "CMAKE_CXX_FLAGS_DEBUG": "/Od /Wall /EHsc",
                "CMAKE_C_FLAGS_DEBUG": "/Od /Wall /EHsc",
                "CMAKE_CXX_FLAGS_ASAN": "/Od /fsanitize=address /Wall /EHsc",
                "CMAKE_C_FLAGS_ASAN": "/Od /fsanitize=address /Wall /EHsc",
                "CMAKE_EXE_LINKER_FLAGS_ASAN": "/fsanitize=address"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-gcc",
            "configurePreset": "linux-gcc"
        },
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang"
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc"
        },
        {
            "name": "windows-msvc-debug",
            "inherits": [ "windows-msvc" ],
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "inherits": [
                "windows-msvc"
            ],
            "configuration": "Release"
        },
        {
            "name": "windows-msvc-asan",
            "inherits": [
                "windows-msvc"
            ],
            "configuration": "Asan"
        }
    ],
    "testPresets": [
        {
            "name": "linux-gcc",
            "configurePreset": "linux-gcc"
        },
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang"
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc"
        },
        {
            "name": "windows-msvc-debug",
            "inherits": [ "windows-msvc" ],
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "inherits": [
                "windows-msvc"
            ],
            "configuration": "Release"
        },
        {
            "name": "windows-msvc-asan",
            "inherits": [
                "windows-msvc"
            ],
            "configuration": "Asan"
        }
    ]
}
