{
    "version": 8,
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "configurePresets": [
        {
            "name": "linux-base",
            "displayName": "linux-base",
            "description": "Base configuration for linux builds",
            "generator": "Ninja Multi-Config",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Asan",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/out/build/${presetName}/$<CONFIG>/bin",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -Wall -Werror -pedantic",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -ggdb -DNDEBUG -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_DEBUG": "-Og -ggdb -DNDEBUG -Wall -Werror -pedantic",
                "CMAKE_CXX_FLAGS_ASAN": "-O0 -fsanitize=address,undefined -Wall -Werror -pedantic",
                "CMAKE_C_FLAGS_ASAN": "-O0 -fsanitize=address,undefined -Wall -Werror -pedantic",
                "CMAKE_EXE_LINKER_FLAGS_ASAN": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "linux-gcc",
            "description": "Build for linux with gcc",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "description": "Build for linux with clang",
            "inherits": [
                "linux-base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-gcc", "configurePreset": "linux-gcc" },
        { "name": "linux-clang", "configurePreset": "linux-clang" }
    ],
    "testPresets": [
        { "name": "linux-gcc", "configurePreset": "linux-gcc" },
        { "name": "linux-clang", "configurePreset": "linux-clang" }
    ]
}
